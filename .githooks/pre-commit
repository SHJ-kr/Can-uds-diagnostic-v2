#!/bin/bash
# [pre-commit 훅] 커밋 "직전"에, 지금 커밋에 포함될 파일(staged)만 검사.
# clang-format: 위반 있으면 커밋 자체를 막음 (그 자리에서 바로 고칠 수 있는 문제라서)
# MISRA-C: 위반 있어도 경고만 하고 커밋은 허용 (기존 레거시 코드에 166건이나 있어서
#          막아버리면 영원히 커밋을 못 하게 됨 - 점진적으로 줄여나가는 전략)

STAGED_C_H=$(git diff --cached --name-only --diff-filter=ACM -- '*.c' '*.h')

if [ -z "$STAGED_C_H" ]; then
    exit 0  # C/H 파일 변경 없으면 아예 검사 안 함
fi

echo "🔍 pre-commit: clang-format 검사 중..."
if ! clang-format --dry-run --Werror $STAGED_C_H 2>&1; then
    echo ""
    echo "❌ clang-format 위반 발견 - 커밋이 차단되었습니다."
    echo "   다음 명령어로 자동 수정 후 다시 커밋하세요:"
    echo "   clang-format -i $STAGED_C_H"
    exit 1
fi
echo "✅ clang-format 통과"

echo "🔍 pre-commit: MISRA-C 검사 중 (경고만, 커밋은 막지 않음)..."
STAGED_C=$(git diff --cached --name-only --diff-filter=ACM -- '*.c')
if [ -n "$STAGED_C" ]; then
    MISRA_ADDON=$(find / -iname "misra.py" 2>/dev/null | head -1)
    if [ -n "$MISRA_ADDON" ]; then
        TMPOUT=$(mktemp)
        cppcheck --dump -I include $STAGED_C >/dev/null 2>&1
        for f in $STAGED_C; do
            [ -f "$f.dump" ] && python3 "$MISRA_ADDON" --cli "$f.dump" 2>/dev/null
            rm -f "$f.dump"  # 임시 dump 파일 정리
        done > "$TMPOUT"
        if [ -s "$TMPOUT" ]; then
            COUNT=$(wc -l < "$TMPOUT")
            echo "⚠️  MISRA-C 위반 ${COUNT}건 발견 (커밋은 막지 않음, 참고만 하세요)"
        else
            echo "✅ MISRA-C 위반 없음"
        fi
        rm -f "$TMPOUT"
    fi
fi

exit 0
